{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "0.5.0",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "http://127.0.0.1:23119/*",
    "http://localhost:23119/*",
    "http://127.0.0.1:1969/*",
    "http://localhost:1969/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.cnki.net/*",
        "*://doi.org/*",
        "*://*.doi.org/*",
        "*://sciencedirect.com/*",
        "*://*.sciencedirect.com/*",
        "*://scopus.com/*",
        "*://*.scopus.com/*",
        "*://webofscience.com/*",
        "*://*.webofscience.com/*",
        "*://webofscience.clarivate.cn/*",
        "*://springer.com/*",
        "*://*.springer.com/*",
        "*://wiley.com/*",
        "*://*.wiley.com/*",
        "*://pubmed.ncbi.nlm.nih.gov/*",
        "*://*.pubmed.ncbi.nlm.nih.gov/*",
        "*://arxiv.org/*",
        "*://*.arxiv.org/*",
        "*://ieee.org/*",
        "*://*.ieee.org/*",
        "*://acm.org/*",
        "*://*.acm.org/*",
        "*://tandfonline.com/*",
        "*://*.tandfonline.com/*",
        "*://mdpi.com/*",
        "*://*.mdpi.com/*"
      ],
      "css": ["src/content.css"],
      "js": [
        "src/common/i18n.js",
        "src/common/backend-contract.js",
        "src/common/ui-state.js",
        "src/common/page-controller.js",
        "src/common/sender-security.js",
        "src/common/normalization.js",
        "src/extractors/cnki.js",
        "src/extractors/scopus.js",
        "src/extractors/web-of-science.js",
        "src/extractors/generic.js",
        "src/extractors/runner.js",
        "src/adapters/cnki.js",
        "src/adapters/scopus.js",
        "src/adapters/web-of-science.js",
        "src/adapters/sciencedirect.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "src/options.html"
}
