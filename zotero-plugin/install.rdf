<?xml version="1.0"?>
<RDF xmlns="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:em="http://www.mozilla.org/2004/em-rdf#">
  <Description about="urn:mozilla:install-manifest">
    <em:id>paper-library-checker@he-chun.github.io</em:id>
    <em:name>Paper Library Checker</em:name>
    <em:version>0.4.0</em:version>
    <em:description>A third-party add-on for Zotero that checks a local library for scholarly articles.</em:description>
    <em:creator>he-chun</em:creator>
    <em:type>2</em:type>
    <em:bootstrap>true</em:bootstrap>
    <em:multiprocessCompatible>true</em:multiprocessCompatible>
    <em:targetApplication>
      <Description>
        <em:id>zotero@chnm.gmu.edu</em:id>
        <em:minVersion>9.0</em:minVersion>
        <em:maxVersion>9.0.*</em:maxVersion>
      </Description>
    </em:targetApplication>
  </Description>
</RDF>
